    - languageCode: en
      text: The Tower
    localizedDescriptions:
    - languageCode: zh-CN
      text: "\u56DE\u6536\u4EF7\u503C\uFF1A\u65E0\u6CD5\u8BC4\u4F30\u3002\n\u5168\u533A\u57DF\u7684MEMENTO\u4FB5\u8680\u53CD\u5E94\u5747\u6307\u5411\u6B64\u5904\u3002\n\u5185\u90E8\u7ED3\u6784\u53CA\u7269\u8D44\u65E0\u6CD5\u626B\u63CF\u3002\nMEMENTO\u4FB5\u8680\u5A01\u80C1\u8BC4\u4F30\uFF1A\u6781\u9AD8\u3002"
    - languageCode: ja
      text: "\u56DE\u53CE\u4FA1\u5024\uFF1A\u8A55\u4FA1\u4E0D\u80FD\u3002\n\u5168\u533A\u57DF\u306EMEMENTO\u4FB5\u8755\u53CD\u5FDC\u304C\u3001\u3053\u306E\u5730\u70B9\u3092\u6307\u5411\u3002\n\u5185\u90E8\u69CB\u9020\u304A\u3088\u3073\u7269\u8CC7\u306F\u30B9\u30AD\u30E3\u30F3\u4E0D\u80FD\u3002\nMEMENTO\u4FB5\u8755\u8105\u5A01\u8A55\u4FA1\uFF1A\u6975\u3081\u3066\u9AD8\u3044\u3002"
    - languageCode: en
      text: 'Salvage value: cannot be assessed.

        MEMENTO erosion readings
        from all zones converge on this location.

        Internal structure and
        contents cannot be scanned.

        MEMENTO erosion threat assessment: extreme.'
    raidDayOutputs: []
    raidNightOutputs: []
