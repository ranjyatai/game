  questId: quest_001
  title:
  - languageCode: zh-CN
    text: "\u4F59\u7A79\u751F\u6D3B\u652F\u63F4"
  - languageCode: ja
    text: "\u30B9\u30C6\u30A3\u30EB\u30F4\u30A9\u30EB\u30C8\u751F\u6D3B\u652F\u63F4"
  - languageCode: en
    text: Stillvault Community Support
  description:
  - languageCode: zh-CN
    text: "\u54E6\uFF1F\u770B\u8D77\u6765\u662F\u65B0\u9762\u5B54\u561B\u3002\n\u6B22\u8FCE\u6765\u5230\u4F59\u7A79\u2014\u2014\u4EBA\u7C7B\u6700\u540E\u7684\u5B89\u5C45\u6240\u3002\u6211\u53EB\u505A\u742A\u4E9A\u62C9\uFF0C\u63A5\u4E0B\u6765\u7684\u65E5\u5FD7\u8BF7\u591A\u5173\u7167\u5566\uFF01"
  - languageCode: ja
    text: "\u3042\u308C\uFF1F \u898B\u306A\u3044\u9854\u3067\u3059\u306D\u3002\n\u30B9\u30C6\u30A3\u30EB\u30F4\u30A9\u30EB\u30C8\u3078\u3088\u3046\u3053\u305D\u3002\u4EBA\u985E\u6700\u5F8C\u306E\u5B89\u4F4F\u306E\u5730\u3067\u3059\u3088\u3002\n\u79C1\u306F\u30AD\u30A2\u30E9\u3002\u3053\u308C\u304B\u3089\u3088\u308D\u3057\u304F\u306D\uFF01"
  - languageCode: en
    text: 'Hey, you''re new around here, aren''t you?

      Welcome to Stillvault,
      humanity''s last safe haven.

      I''m Chiara. Nice to meet you!'
  heroImage: {fileID: 0}
  regionDisplayName:
