  m_Script: {fileID: 11500000, guid: bcef4979f273ebc4084e1da01b2d10ae, type: 3}
  m_Name: "\u4F9B\u7ED9\u7AD9\u7684\u742A\u4E9A\u62C9"
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSentenceLibrary
  chapterGroup: 
  entries:
  - sentenceId: Chapter 1-001
    chapter: ab9c3dfc61e9445c96cb4fce930080f7
    note: 
    speakerUnit: {fileID: 11400000, guid: 04e0c90e408f3f640985757651f20d58, type: 2}
    speakerAnonymous: 0
    speakerAliasOverride:
    - languageCode: zh-CN
      text: 
    - languageCode: ja
      text: 
    - languageCode: en
      text: 
    texts:
    - languageCode: zh-CN
      text: "\u54CE\u5440\uFF0C\u8FD9\u4E0D\u662F{player}\u5417\uFF01\u4ECA\u5929\u6709\u4EC0\u4E48\u9700\u8981\u5417\uFF1F"
    - languageCode: ja
      text: "\u3042\u3089\u3001{player}\u3055\u3093\u3067\u306F\u306A\u3044\u3067\u3057\u3087\u3046\u304B\uFF01\u4ECA\u65E5\u306F\u4F55\u304B\u5FA1\u7528\uFF1F"
    - languageCode: en
      text: Oh, aren't you {player}!Is there something I can help you with today?
    voices:
    - languageCode: zh-CN
      clip: {fileID: 0}
    - languageCode: ja
      clip: {fileID: 0}
    - languageCode: en
      clip: {fileID: 0}
  - sentenceId: Chapter 1-002
    chapter: ab9c3dfc61e9445c96cb4fce930080f7
    note: 
    speakerUnit: {fileID: 11400000, guid: 04e0c90e408f3f640985757651f20d58, type: 2}
    speakerAnonymous: 0
    speakerAliasOverride:
    - languageCode: zh-CN
      text: 
    - languageCode: ja
      text: 
    - languageCode: en
      text: 
    texts:
    - languageCode: zh-CN
      text: "\u8C22\u8C22\u60E0\u987E\uFF0C\u6B22\u8FCE\u4E0B\u6B21\u518D\u6765\uFF01"
    - languageCode: ja
      text: "\u307E\u3044\u3069\u3042\u308A\uFF01\u307E\u305F\u306E\u3054\u5229\u7528\u304A\u5F85\u3061\u3057\u3066\u304A\u308A\u307E\u3059\u3002"
    - languageCode: en
      text: Thanks for your purchase! We look forward to seeing you again.
    voices:
    - languageCode: zh-CN
      clip: {fileID: 0}
    - languageCode: ja
      clip: {fileID: 0}
    - languageCode: en
      clip: {fileID: 0}
  - sentenceId: Chapter 1-003
    chapter: ab9c3dfc61e9445c96cb4fce930080f7
    note: "\u95F2\u804A"
    speakerUnit: {fileID: 11400000, guid: 04e0c90e408f3f640985757651f20d58, type: 2}
    speakerAnonymous: 0
    speakerAliasOverride:
    - languageCode: zh-CN
      text: 
    - languageCode: ja
      text: 
    - languageCode: en
      text: 
    texts:
    - languageCode: zh-CN
      text: "\u6709\u4EC0\u4E48\u70E6\u607C\u7684\u4E8B\u60C5\u5417\uFF1F"
    - languageCode: ja
      text: "\u4F55\u304B\u56F0\u3063\u3066\u308B\u3053\u3068\u3001\u3042\u308A\u307E\u3059\u304B\uFF1F"
    - languageCode: en
      text: Is something bothering you?
    voices:
    - languageCode: zh-CN
      clip: {fileID: 0}
    - languageCode: ja
      clip: {fileID: 0}
    - languageCode: en
      clip: {fileID: 0}
  - sentenceId: Chapter 1-004
    chapter: ab9c3dfc61e9445c96cb4fce930080f7
    note: "\u95F2\u804A"
    speakerUnit: {fileID: 11400000, guid: 04e0c90e408f3f640985757651f20d58, type: 2}
    speakerAnonymous: 0
    speakerAliasOverride:
    - languageCode: zh-CN
      text: 
    - languageCode: ja
      text: 
    - languageCode: en
      text: 
    texts:
    - languageCode: zh-CN
      text: "\u55EF\u55EF\uFF0C\u770B\u8D77\u6765\u50CF\u662F\u6709\u5FC3\u4E8B\uFF1F\u8981\u4E0D\u8981\u8BF4\u7ED9\u6211\u542C\u542C\uFF1F"
    - languageCode: ja
      text: "\u3046\u3093\u3046\u3093\u2026\u2026\u4F55\u304B\u6C17\u306B\u306A\u308B\u3053\u3068\u304C\u3042\u308B\u307F\u305F\u3044\u3067\u3059\u306D\u3002\u3088\u304B\u3063\u305F\u3089\u3001\u805E\u304B\u305B\u3066\u304F\u3060\u3055\u3044\u3002"
    - languageCode: en
      text: Hmm... looks like something's on your mind. Want to tell me about it?
    voices:
    - languageCode: zh-CN
      clip: {fileID: 0}
    - languageCode: ja
      clip: {fileID: 0}
    - languageCode: en
      clip: {fileID: 0}
  - sentenceId: Chapter 1-005
    chapter: ab9c3dfc61e9445c96cb4fce930080f7
    note: "\u544A\u522B\uFF08\u5019\u9009\uFF09"
    speakerUnit: {fileID: 11400000, guid: 04e0c90e408f3f640985757651f20d58, type: 2}
    speakerAnonymous: 0
    speakerAliasOverride:
    - languageCode: zh-CN
      text: 
    - languageCode: ja
      text: 
    - languageCode: en
      text: 
    texts:
    - languageCode: zh-CN
      text: "\u5343\u4E07\u8981\u5C0F\u5FC3\u54E6\uFF01"
    - languageCode: ja
      text: "\u304F\u308C\u3050\u308C\u3082\u304A\u6C17\u3092\u3064\u3051\u3066\u304F\u3060\u3055\u3044\u306D\uFF01"
    - languageCode: en
      text: Please, be careful out there!
    voices: []
