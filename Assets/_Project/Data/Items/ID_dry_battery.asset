  nameKey: item_name_dry_battery
  descKey: item_desc_dry_battery
  iconKey: icon_dry_battery
  displayName: "\u5E72\u7535\u6C60"
  note: 
  description: "\u901A\u7528\u89C4\u683C\u7684\u5E72\u7535\u6C60\uFF0C\u5E38\u89C1\u4E8E\u65E7\u5F0F\u95E8\u7981\u3001\u624B\u7535\u4E0E\u4F4E\u529F\u7387\u7EC8\u7AEF\u3002\n\u5916\u5C42\u5305\u88C5\u56E0\u6C27\u5316\u892A\u8272\uFF0C\u9732\u51FA\u4E86\u4E0B\u65B9\u7684\u9ED1\u8272\u91D1\u5C5E\u7B52\u8EAB\u3002\n\u4F59\u7A79\u505C\u6B62\u7EF4\u62A4\u5916\u533A\u540E\uFF0C\u8FD9\u7C7B\u7535\u6C60\u53CD\u800C\u6210\u4E86\u6700\u5BB9\u6613\u6D41\u901A\u7684\u80FD\u6E90\u3002"
  icon: {fileID: 21300000, guid: e754904d28fdeea4fa2cf051aa5ef1e5, type: 3}
  localizedNames:
  - languageCode: zh-CN
    text: "\u5E72\u7535\u6C60"
  - languageCode: ja-JP
    text: "\u4E7E\u96FB\u6C60"
  - languageCode: en-US
    text: Dry Battery
  - languageCode: ja
    text: "\u30D0\u30C3\u30C6\u30EA\u30FC"
  - languageCode: en
    text: Dry  battery
  localizedDescriptions:
  - languageCode: zh-CN
    text: "\u901A\u7528\u89C4\u683C\u7684\u5E72\u7535\u6C60\uFF0C\u5E38\u89C1\u4E8E\u65E7\u5F0F\u95E8\u7981\u3001\u624B\u7535\u4E0E\u4F4E\u529F\u7387\u7EC8\u7AEF\u3002\n\u5916\u5C42\u5305\u88C5\u56E0\u6C27\u5316\u892A\u8272\uFF0C\u9732\u51FA\u4E86\u4E0B\u65B9\u7684\u9ED1\u8272\u91D1\u5C5E\u7B52\u8EAB\u3002\n\u4F59\u7A79\u505C\u6B62\u7EF4\u62A4\u5916\u533A\u540E\uFF0C\u8FD9\u7C7B\u7535\u6C60\u53CD\u800C\u6210\u4E86\u6700\u5BB9\u6613\u6D41\u901A\u7684\u80FD\u6E90\u3002"
  - languageCode: ja-JP
    text: "\u4E00\u822C\u7684\u306A\u96FB\u6E90\u7D20\u6750\u3067\u3001\u4E00\u90E8\u8A2D\u5099\u306B\u96FB\u529B\u3092\u4F9B\u7D66\u3067\u304D\u308B\u3002"
  - languageCode: en-US
    text: A common energy material used to power certain devices.
  - languageCode: ja
    text: "\u6C4E\u7528\u898F\u683C\u306E\u30D0\u30C3\u30C6\u30EA\u30FC\u3002\u65E7\u5F0F\u306E\u8A8D\u8A3C\u7AEF\u672B\u3084\u30CF\u30F3\u30C9\u30E9\u30A4\u30C8\u3001\u4F4E\u51FA\u529B\u306E\u643A\u5E2F\u7AEF\u672B\u306A\u3069\u306B\u4F7F\u308F\u308C\u3066\u3044\u308B\u3002\n\u5916\u88C5\u306F\u9178\u5316\u306B\u3088\u3063\u3066\u8272\u3042\u305B\u3001\u3068\u3053\u308D\u3069\u3053\u308D\u4E0B\u5730\u306E\u9ED2\u3044\u91D1\u5C5E\u7B52\u304C\u9732\u51FA\u3057\u3066\u3044\u308B\u3002\n\u4F59\u7A79\u304C\u5916\u533A\u306E\u4FDD\u5B88\u3092\u505C\u6B62\u3057\u3066\u304B\u3089\u306F\u3001\u3053\u3046\u3057\u305F\u96FB\u6C60\u304C\u304B\u3048\u3063\u3066\u6700\u3082\u6D41\u901A\u3057\u3084\u3059\u3044\u96FB\u6E90\u3068\u306A\u3063\u305F\u3002"
  - languageCode: en
    text: 'A general-purpose dry battery, commonly used in old access terminals,
      handlights, and low-power devices.

      Its outer wrap has faded and oxidized
      with age, exposing the black metal casing underneath.

      After Yuqiong
      stopped maintaining the outer districts, batteries like this became one of
      the easiest power sources to trade.'
