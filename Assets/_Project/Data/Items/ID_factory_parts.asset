  nameKey: item_name_factory_parts
  descKey: item_desc_factory_parts
  iconKey: icon_factory_parts
  displayName: "\u5DF2\u52A0\u5DE5\u7684\u5DE5\u5382\u96F6\u4EF6"
  note: 
  description: "\u7ECF\u8FC7\u591A\u91CD\u5DE5\u827A\u7684\u7684\u57FA\u7840\u5DE5\u4E1A\u96F6\u4EF6\u3002 
    \n\u5E38\u7528\u4E8E\u5236\u9020\u8BBE\u5907\u6846\u67B6\u3001\u7EF4\u4FEE\u4F20\u52A8\u7ED3\u6784\uFF0C\u6216\u66FF\u6362\u635F\u574F\u7684\u673A\u68B0\u8FDE\u63A5\u90E8\u3002 
    \n\u867D\u7136\u578B\u53F7\u5E76\u4E0D\u7F55\u89C1\uFF0C\u4F46\u5728\u5916\u533A\u5DE5\u5382\u505C\u6446\u540E\uFF0C\u72B6\u6001\u826F\u597D\u7684\u52A0\u5DE5\u4EF6\u5DF2\u7ECF\u8D8A\u6765\u8D8A\u96BE\u627E\u3002"
  icon: {fileID: 21300000, guid: a5183090bce418845842d44dec32dbea, type: 3}
  localizedNames:
  - languageCode: zh-CN
    text: "\u5DF2\u52A0\u5DE5\u7684\u5DE5\u5382\u96F6\u4EF6"
  - languageCode: ja-JP
    text: "\u5DE5\u5834\u90E8\u54C1"
  - languageCode: en-US
    text: Factory Parts
  - languageCode: ja
    text: "\u52A0\u5DE5\u6E08\u307F\u306E\u90E8\u54C1 "
  - languageCode: en
    text: Processed Factory Part
  localizedDescriptions:
  - languageCode: zh-CN
    text: "\u7ECF\u8FC7\u591A\u91CD\u5DE5\u827A\u7684\u7684\u57FA\u7840\u5DE5\u4E1A\u96F6\u4EF6\u3002 
      \n\u5E38\u7528\u4E8E\u5236\u9020\u8BBE\u5907\u6846\u67B6\u3001\u7EF4\u4FEE\u4F20\u52A8\u7ED3\u6784\uFF0C\u6216\u66FF\u6362\u635F\u574F\u7684\u673A\u68B0\u8FDE\u63A5\u90E8\u3002 
      \n\u867D\u7136\u578B\u53F7\u5E76\u4E0D\u7F55\u89C1\uFF0C\u4F46\u5728\u5916\u533A\u5DE5\u5382\u505C\u6446\u540E\uFF0C\u72B6\u6001\u826F\u597D\u7684\u52A0\u5DE5\u4EF6\u5DF2\u7ECF\u8D8A\u6765\u8D8A\u96BE\u627E\u3002"
  - languageCode: ja-JP
    text: "\u88FD\u9020\u3084\u4FEE\u7406\u306B\u4F7F\u3048\u308B\u57FA\u790E\u5DE5\u696D\u90E8\u54C1\u3002"
  - languageCode: en-US
    text: Basic industrial parts used in crafting and repair.
  - languageCode: ja
    text: "\u3044\u304F\u3064\u3082\u306E\u52A0\u5DE5\u5DE5\u7A0B\u3092\u7D4C\u3066\u4F5C\u3089\u308C\u305F\u3001\u57FA\u790E\u7684\u306A\u5DE5\u696D\u90E8\u54C1\u3002\n\u8A2D\u5099\u30D5\u30EC\u30FC\u30E0\u306E\u88FD\u9020\u3001\u99C6\u52D5\u90E8\u306E\u4FEE\u7406\u3001\u7834\u640D\u3057\u305F\u6A5F\u68B0\u63A5\u5408\u90E8\u306E\u4EA4\u63DB\u306A\u3069\u306B\u4F7F\u308F\u308C\u308B\u3002\n\u73CD\u3057\u3044\u578B\u756A\u3067\u306F\u306A\u3044\u304C\u3001\u5916\u533A\u306E\u5DE5\u5834\u304C\u505C\u6B62\u3057\u3066\u4EE5\u964D\u3001\u72B6\u614B\u306E\u826F\u3044\u52A0\u5DE5\u90E8\u54C1\u306F\u898B\u3064\u304B\u308A\u306B\u304F\u304F\u306A\u3063\u3066\u3044\u308B\u3002"
  - languageCode: en
    text: 'A basic industrial part shaped through multiple machining processes.

      Used
      to build equipment frames, repair drive mechanisms, or replace damaged mechanical
      joints.

      The model itself is not uncommon, but since the outer district
      factories shut down, machined parts in good condition have become harder to
      find.'
