    description: "\u5C55\u5F00\u7279\u6548\u529B\u573A\uFF0C\u8C41\u514D\u4E00\u6B21\u8150\u8680\u5F02\u5E38\uFF0C\u968F\u540E\u8FDB\u5165
      150 \u79D2\u7684\u6062\u590D\u3002\n\u5BF9\u5E94\u5C5E\u6027\u7684\u6297\u6027\u5F3A\u5316\u8FBE\u5230
      5 \u7EA7\u540E\u751F\u6548\u3002"
    localizedDescriptions:
