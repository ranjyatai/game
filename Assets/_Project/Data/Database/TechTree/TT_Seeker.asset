  m_Name: TT_Seeker
  m_EditorClassIdentifier: Assembly-CSharp::TechTreeGraphAsset
  graphId: tech_tree_seeker
  displayName: "\u63A2\u7D22\u8005"
  note: "AFP \u9002\u5E94\u7CFB\u7EDF\uFF1A\u63A0\u593A\u3001\u81EA\u9002\u5E94\u3001\u8BCD\u6761\u89E3\u9501\u3001\u8BCD\u6761\u8FDB\u5316(\u7279\u6548\u529B\u573A/\u751F\u547D\u4FDD\u9669/\u5F02\u5E38\u8FFD\u4F24/\u6B66\u5668\u4E13\u7CBE)\u3002\u8282\u70B9
    ID \u4E0E\u4EE3\u7801\u91CC\u7684 SkyPrisonAfpAbilityTable \u5BF9\u5E94\uFF0C\u522B\u968F\u610F\u6539\u3002"
  layoutMode: 0
  nodes:
  - nodeId: seeker_root
    nodeName: "AFP\u7CFB\u7EDF\u89E3\u653E"
    localizedNames:
    - languageCode: zh-CN
      text: "AFP\u7CFB\u7EDF\u89E3\u653E"
    - languageCode: ja
      text: "AFP\u30B7\u30B9\u30C6\u30E0\u89E3\u653E"
    - languageCode: en
      text: AFP System Unlock
    description: "\u5F00\u653EAFP\u7CFB\u7EDF\u90E8\u7F72\u80FD\u529B\u3002\u8FDB\u5165\u526F\u672C\u540E\uFF0CAFP
      \u7CFB\u7EDF\u4F1A\u6301\u7EED\u5206\u6790\u6218\u5C40\u3001\u6F14\u7B97\u672C\u5C40\u7684\u53D6\u80DC\u8DEF\u5F84\uFF1B\u53EF\u5728
      AFP \u8D2D\u4E70\u533A\u6309\u6F14\u7B97\u7ED3\u679C\u90E8\u7F72\u5F3A\u5316\u3002"
    localizedDescriptions:
    - languageCode: zh-CN
      text: "\u5F00\u653EAFP\u7CFB\u7EDF\u90E8\u7F72\u80FD\u529B\u3002\u8FDB\u5165\u526F\u672C\u540E\uFF0CAFP
        \u7CFB\u7EDF\u4F1A\u6301\u7EED\u5206\u6790\u6218\u5C40\u3001\u6F14\u7B97\u672C\u5C40\u7684\u53D6\u80DC\u8DEF\u5F84\uFF1B\u53EF\u5728
        AFP \u8D2D\u4E70\u533A\u6309\u6F14\u7B97\u7ED3\u679C\u90E8\u7F72\u5F3A\u5316\u3002"
    - languageCode: ja
      text: "AFP\u30B7\u30B9\u30C6\u30E0\u306E\u5C55\u958B\u80FD\u529B\u3092\u89E3\u653E\u3059\u308B\u3002\u51FA\u6483\u5F8C\u3001AFP\u30B7\u30B9\u30C6\u30E0\u304C\u6226\u6CC1\u3092\u7D99\u7D9A\u7684\u306B\u5206\u6790\u3057\u3001\u3053\u306E\u4F5C\u6226\u306E\u52DD\u3061\u7B4B\u3092\u6F14\u7B97\u3059\u308B\u3002AFP\u8CFC\u5165\u30A8\u30EA\u30A2\u3067\u6F14\u7B97\u7D50\u679C\u306B\u57FA\u3065\u304D\u5F37\u5316\u3092\u5C55\u958B\u3067\u304D\u308B\u3002"
    - languageCode: en
      text: Unlocks AFP system deployment. Once deployed in a raid, the AFP system
        continuously analyzes the battle and calculates a winning path; deploy enhancements
        based on its results at an AFP Purchase Zone.
    designerNote: "\u6548\u679C\u8BF4\u660E\uFF1A\n\u89E3\u9501\u9002\u5E94\u7CFB\u7EDF\uFF1A\u8FDB\u672C\u540E\u5728
      AFP \u8D2D\u4E70\u533A\u8FDB\u884C AFP \u90E8\u7F72\u3002"
    enabled: 1
    primaryParentIndex: -1
    secondaryRequirements: []
    externalCondition: 0
