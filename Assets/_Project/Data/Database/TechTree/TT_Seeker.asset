  - nodeId: seeker_usurper
    nodeName: "\u7BE1\u593A\u8005"
    localizedNames:
    - languageCode: zh-CN
      text: "\u7BE1\u593A\u8005"
    - languageCode: ja
      text: "\u7C12\u596A\u8005"
    - languageCode: en
      text: Usurper
    description: "\u5F00\u653E\u9002\u5E94\u9879\u76EE\uFF1A\u7BE1\u593A\u8005\uFF0C\u6700\u9AD8
      10 \u7EA7\u3002\u8FFD\u52A0\u751F\u547D\u4E0E\u7269\u7406\u653B\u51FB\u5F3A\u5316\u5747\u8FBE\u5230
      10 \u7EA7\u540E\u53EF\u8D2D\u4E70\u3002\n\u53D7\u5230\u7684\u4F24\u5BB3\u6709\u4E00\u90E8\u5206\u8F6C\u4E3A\u8840\u6761\u4E0A\u7684\u7EA2\u8272\u90E8\u5206\uFF0C\u5E76\u968F\u65F6\u95F4\u6D88\u9000\uFF081
      \u7EA7 30%\uFF0C10 \u7EA7 60%\uFF09\u3002\n\u653B\u51FB\u654C\u4EBA\u65F6\uFF0C\u9020\u6210\u4F24\u5BB3\u7684\u4E00\u90E8\u5206\u8F6C\u4E3A\u751F\u547D\u56DE\u590D\uFF0C\u4E14\u53EA\u80FD\u56DE\u590D\u7EA2\u8272\u90E8\u5206\uFF08\u8FD1\u6218
      20%\u201380%\uFF0C\u8FDC\u7A0B\u4E3A\u8FD1\u6218\u7684 40%\uFF09\u3002"
    localizedDescriptions:
    - languageCode: zh-CN
      text: "\u5F00\u653E\u9002\u5E94\u9879\u76EE\uFF1A\u7BE1\u593A\u8005\uFF0C\u6700\u9AD8
        10 \u7EA7\u3002\u8FFD\u52A0\u751F\u547D\u4E0E\u7269\u7406\u653B\u51FB\u5F3A\u5316\u5747\u8FBE\u5230
        10 \u7EA7\u540E\u53EF\u8D2D\u4E70\u3002\n\u53D7\u5230\u7684\u4F24\u5BB3\u6709\u4E00\u90E8\u5206\u8F6C\u4E3A\u8840\u6761\u4E0A\u7684\u7EA2\u8272\u90E8\u5206\uFF0C\u5E76\u968F\u65F6\u95F4\u6D88\u9000\uFF081
        \u7EA7 30%\uFF0C10 \u7EA7 60%\uFF09\u3002\n\u653B\u51FB\u654C\u4EBA\u65F6\uFF0C\u9020\u6210\u4F24\u5BB3\u7684\u4E00\u90E8\u5206\u8F6C\u4E3A\u751F\u547D\u56DE\u590D\uFF0C\u4E14\u53EA\u80FD\u56DE\u590D\u7EA2\u8272\u90E8\u5206\uFF08\u8FD1\u6218
        20%\u201380%\uFF0C\u8FDC\u7A0B\u4E3A\u8FD1\u6218\u7684 40%\uFF09\u3002"
    - languageCode: ja
      text: "\u9069\u5FDC\u9805\u76EE\u3092\u89E3\u653E\uFF1A\u7C12\u596A\u8005\u3001\u6700\u592710\u30EC\u30D9\u30EB\u3002\u8FFD\u52A0\u30E9\u30A4\u30D5\u3068\u7269\u7406\u653B\u6483\u5F37\u5316\u304C\u5171\u306B\u30EC\u30D9\u30EB10\u306B\u9054\u3059\u308B\u3068\u8CFC\u5165\u3067\u304D\u308B\u3002\n\u53D7\u3051\u305F\u30C0\u30E1\u30FC\u30B8\u306E\u4E00\u90E8\u304CHP\u30B2\u30FC\u30B8\u306E\u8D64\u3044\u90E8\u5206\u306B\u306A\u308A\u3001\u6642\u9593\u3068\u3068\u3082\u306B\u6D88\u3048\u308B\uFF08\u30EC\u30D9\u30EB1\u306730%\u3001\u30EC\u30D9\u30EB10\u306760%\uFF09\u3002\n\u6575\u3092\u653B\u6483\u3059\u308B\u3068\u4E0E\u3048\u305F\u30C0\u30E1\u30FC\u30B8\u306E\u4E00\u90E8\u304CHP\u56DE\u5FA9\u306B\u5909\u308F\u308A\u3001\u8D64\u3044\u90E8\u5206\u306E\u307F\u56DE\u5FA9\u3067\u304D\u308B\uFF08\u8FD1\u63A520%\u301C80%\u3001\u9060\u8DDD\u96E2\u306F\u8FD1\u63A5\u306E40%\uFF09\u3002"
    - languageCode: en
      text: 'Unlocks adaptation entry: Usurper, up to level 10. Purchasable once
        Bonus Vitality and Physical Damage both reach level 10.

        Part of
        the damage you take becomes a red section of the HP bar that fades over time
        (30% at level 1, 60% at level 10).

        Attacking enemies converts part
        of the damage dealt into healing that can only restore the red section (melee
        20%-80%, ranged 40% of melee).'
    designerNote: "\u6548\u679C\u8BF4\u660E\uFF1A\n\u70B9\u4EAE\u540E\uFF0CAFP \u7A97\u53E3\u91CC\u51FA\u73B0\u72EC\u7ACB\u7684\u300C\u7BE1\u593A\u8005\u300D\u4E00\u884C\uFF0C\u8FFD\u52A0\u751F\u547D\u3001\u7269\u7406\u653B\u51FB\u5F3A\u5316\u5404
      \u2265 10 \u7EA7\u624D\u80FD\u8D2D\u4E70\uFF0C\u6700\u9AD8 10 \u7EA7\u3002\n\u53D7\u5230\u7684\u4F24\u5BB3\uFF0C\u6709
      30%\uFF081 \u7EA7\uFF09\u81F3 60%\uFF0810 \u7EA7\uFF09\u8F6C\u4E3A\u8840\u6761\u4E0A\u7684\u7EA2\u8272\u90E8\u5206\uFF0C\u968F\u65F6\u95F4\u6D88\u9000\u3002\n\u653B\u51FB\u654C\u4EBA\u65F6\uFF0C\u9020\u6210\u4F24\u5BB3\u7684\u4E00\u90E8\u5206\u8F6C\u5316\u4E3A\u751F\u547D\u56DE\u590D\uFF0C\u53EA\u80FD\u56DE\u590D\u7EA2\u8272\u90E8\u5206\uFF1A\u8FD1\u6218
      20%\u201380%\uFF0C\u8FDC\u7A0B\u4E3A\u8FD1\u6218\u7684 40%\u3002\n\u524D\u7F6E\uFF1A\u8BCD\u6761\uFF1A\u653B\u51FB\u5F3A\u5316\u3002"
    enabled: 1
    primaryParentIndex: 7
