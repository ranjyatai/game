      5 \u7EA7\u540E\u751F\u6548\u3002"
    localizedDescriptions:
    - languageCode: zh-CN
      text: "\u5927\u5251\u9650\u5B9A\u3002\u51FB\u6740\u654C\u4EBA\u65F6\uFF0C\u6062\u590D\u6700\u5927
        LP \u7684 12%\u3002\n\u51FB\u6740\u751F\u547D\u4E0A\u9650 250 \u4EE5\u4E0A\u7684\u76EE\u6807\uFF0C\u6062\u590D\u91CF
