  m_Name: TT_Strategist
  m_EditorClassIdentifier: Assembly-CSharp::TechTreeGraphAsset
  graphId: tech_tree_strategist
  displayName: "\u6218\u7565\u5BB6"
  note: "\u6D88\u8017\u54C1(\u836F\u5242)\u4E0E\u8865\u7ED9\uFF1A\u836F\u6548\u5F3A\u5316\u3001\u8282\u7EA6(\u6982\u7387\u4E0D\u6D88\u8017)\u3001\u8D1F\u91CD\u4E0A\u9650\u3001\u7EDF\u7B79\u3002"
  layoutMode: 0
  nodes:
  - nodeId: strategist_root
    nodeName: "\u6218\u672F\u5730\u56FE\u89E3\u653E"
    localizedNames:
    - languageCode: zh-CN
      text: "\u6218\u672F\u5730\u56FE\u89E3\u653E"
    - languageCode: ja
      text: "\u6226\u8853\u30DE\u30C3\u30D7\u89E3\u653E"
    - languageCode: en
      text: Tactical Map Unlock
    description: "\u5F00\u653E\u6218\u672F\u5730\u56FE\u3002\u884C\u52A8\u4E2D\u53EF\u968F\u65F6\u8C03\u51FA\uFF0C\u67E5\u770B\u5DF2\u63A2\u7D22\u533A\u57DF\u7684\u7ACB\u4F53\u7ED3\u6784\uFF0C\u5E76\u6807\u51FA\u64A4\u79BB\u70B9\u3001AFP
      \u8D2D\u4E70\u533A\u4E0E\u5F53\u524D\u4EFB\u52A1\u76EE\u6807\u3002\n\u89C6\u91CE\u5185\u7684\u654C\u4EBA\u4F1A\u4EE5\u7EA2\u70B9\u663E\u793A\u3002"
    localizedDescriptions:
    - languageCode: zh-CN
      text: "\u5F00\u653E\u6218\u672F\u5730\u56FE\u3002\u884C\u52A8\u4E2D\u53EF\u968F\u65F6\u8C03\u51FA\uFF0C\u67E5\u770B\u5DF2\u63A2\u7D22\u533A\u57DF\u7684\u7ACB\u4F53\u7ED3\u6784\uFF0C\u5E76\u6807\u51FA\u64A4\u79BB\u70B9\u3001AFP
        \u8D2D\u4E70\u533A\u4E0E\u5F53\u524D\u4EFB\u52A1\u76EE\u6807\u3002\n\u89C6\u91CE\u5185\u7684\u654C\u4EBA\u4F1A\u4EE5\u7EA2\u70B9\u663E\u793A\u3002"
    - languageCode: ja
      text: "\u6226\u8853\u30DE\u30C3\u30D7\u3092\u89E3\u653E\u3059\u308B\u3002\u4F5C\u6226\u4E2D\u3044\u3064\u3067\u3082\u547C\u3073\u51FA\u3057\u3001\u63A2\u7D22\u6E08\u307F\u533A\u57DF\u306E\u7ACB\u4F53\u69CB\u9020\u3092\u78BA\u8A8D\u3067\u304D\u3001\u64A4\u53CE\u5730\u70B9\u30FBAFP\u8CFC\u5165\u30A8\u30EA\u30A2\u30FB\u73FE\u5728\u306E\u4EFB\u52D9\u76EE\u6A19\u304C\u8868\u793A\u3055\u308C\u308B\u3002\n\u8996\u754C\u5185\u306E\u6575\u306F\u8D64\u3044\u70B9\u3067\u8868\u793A\u3055\u308C\u308B\u3002"
    - languageCode: en
      text: 'Unlocks the Tactical Map. Open it anytime during a raid to view the
        3D layout of explored areas, with extraction points, AFP Purchase Zones,
        and current objectives marked.

        Enemies within sight appear as red
        dots.'
    designerNote: "\u6548\u679C\u8BF4\u660E\uFF1A\n\u89E3\u9501\u6218\u672F\u5730\u56FE(M
      / \u624B\u67C4 View)\uFF1A3D \u5168\u606F\u5730\u56FE\u30014 \u4E2A\u6807\u8BB0\u3001\u4EFB\u52A1\u76EE\u6807\u3001\u89C6\u91CE\u5185\u654C\u4EBA\u7EA2\u70B9\u3002\u4EC5
      RAID \u5185\u53EF\u7528\u3002"
