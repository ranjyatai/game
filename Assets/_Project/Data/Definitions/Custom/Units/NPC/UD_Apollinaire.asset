  m_Script: {fileID: 11500000, guid: 2bbe3305b30b1e04ea576172df23f1ff, type: 3}
  m_Name: UD_Apollinaire
  m_EditorClassIdentifier: Assembly-CSharp::UnitDefinition
  unitId: apollinaire
  displayName: "\u963F\u6CE2\u5229\u5948\u5C14"
  note: "\u4F9B\u7ED9\u7AD9\u7684\u742A\u4E9A\u62C9"
  description: "\u96B6\u5C5E\u4E8E\u4F59\u7A79\u4F9B\u7ED9\u7AD9\u7684\u5DE5\u4F5C\u4EBA\u5458\u3002\u8D1F\u8D23\u7269\u8D44\u6574\u7406\u3001\u88C5\u5907\u8865\u7ED9\u4E0E\u62FE\u8352\u961F\u7684\u51FA\u53D1\u51C6\u5907\u3002
    \r\n\u5DE5\u4F5C\u6001\u5EA6\u7A33\u5B9A\uFF0C\u5728\u7269\u8D44\u77ED\u7F3A\u53CA\u9AD8\u5F3A\u5EA6\u5DE5\u4F5C\u73AF\u5883\u4E0B\u4ECD\u80FD\u7EF4\u6301\u6B63\u5E38\u63A5\u5F85\u4E0E\u4F9B\u7ED9\u6D41\u7A0B\u3002
    \r\n\n\u4FB5\u8680\u5EA6\uFF1A7.4% \n\u4FB5\u8680\u8BC4\u7EA7\uFF1A\u4F4E\uFF08\u65E0\u98CE\u9669\uFF09"
  localizedNames:
  - languageCode: zh-CN
    text: "\u963F\u6CE2\u5229\u5948\u5C14"
  - languageCode: ja
    text: "\u30A2\u30DD\u30EA\u30CD\u30FC\u30EB"
  - languageCode: en
    text: Apollinaire
  localizedDescriptions:
  - languageCode: zh-CN
    text: "\u96B6\u5C5E\u4E8E\u4F59\u7A79\u4F9B\u7ED9\u7AD9\u7684\u5DE5\u4F5C\u4EBA\u5458\u3002\u8D1F\u8D23\u7269\u8D44\u6574\u7406\u3001\u88C5\u5907\u8865\u7ED9\u4E0E\u62FE\u8352\u961F\u7684\u51FA\u53D1\u51C6\u5907\u3002
      \r\n\u5DE5\u4F5C\u6001\u5EA6\u7A33\u5B9A\uFF0C\u5728\u7269\u8D44\u77ED\u7F3A\u53CA\u9AD8\u5F3A\u5EA6\u5DE5\u4F5C\u73AF\u5883\u4E0B\u4ECD\u80FD\u7EF4\u6301\u6B63\u5E38\u63A5\u5F85\u4E0E\u4F9B\u7ED9\u6D41\u7A0B\u3002
      \r\n\n\u4FB5\u8680\u5EA6\uFF1A7.4% \n\u4FB5\u8680\u8BC4\u7EA7\uFF1A\u4F4E\uFF08\u65E0\u98CE\u9669\uFF09"
  - languageCode: ja
    text: "\u30B9\u30C6\u30A3\u30EB\u30F4\u30A9\u30EB\u30C8\u88DC\u7D66\u6240\u306B\u6240\u5C5E\u3059\u308B\u30AA\u30DA\u30EC\u30FC\u30BF\u30FC\u3002\u7269\u8CC7\u306E\u6574\u7406\u3001\u88C5\u5099\u306E\u88DC\u7D66\u3001\u304A\u3088\u3073\u62FE\u8352\u968A\u306E\u51FA\u767A\u6E96\u5099\u3092\u62C5\u5F53\u3059\u308B\u3002\n\u52E4\u52D9\u614B\u5EA6\u306F\u5B89\u5B9A\u3057\u3066\u304A\u308A\u3001\u7269\u8CC7\u4E0D\u8DB3\u3084\u9AD8\u8CA0\u8377\u306E\u4F5C\u696D\u74B0\u5883\u4E0B\u306B\u304A\u3044\u3066\u3082\u3001\u901A\u5E38\u306E\u53D7\u4ED8\u30FB\u88DC\u7D66\u696D\u52D9\u3092\u7DAD\u6301\u3067\u304D\u308B\u3002\n\n\u4FB5\u8755\u7387\uFF1A7.4%\n\u4FB5\u8755\u8A55\u4FA1\uFF1A\u4F4E\uFF08\u5371\u967A\u6027\u306A\u3057\uFF09"
  - languageCode: en
    text: 'An operator assigned to the Stillvault Supply Station. Responsible for
      organizing supplies, distributing equipment, and preparing scavenger teams
      for deployment.

      Maintains consistent work performance and is capable
      of sustaining normal reception and supply operations even under supply shortages
      and high workloads.


      Corruption Level: 7.4%

      Corruption Rating:
      Low (No Risk)'
