  m_Name: UD_AEGIA
  m_EditorClassIdentifier: Assembly-CSharp::UnitDefinition
  unitId: aegia
  displayName: AEGIA
  note: "\u4F59\u7A79\u4EE3\u7406\u8D1F\u8D23\u4EBA"
  description: "AEGIA\uFF0C\u6218\u7565\u7EA7\u673A\u5668\u4EBA\uFF0C\u4EAC\u6781\u91CD\u5DE5A.E.G.I.A\u4F01\u5212\u7684\u6700\u7EC8\u4EA7\u54C1\u3002\n\u73B0\u4EFB\u4F59\u7A79\u4EE3\u7406\u8D1F\u8D23\u4EBA\uFF0C\u8D1F\u8D23\u8BBE\u65BD\u8FD0\u884C\u7BA1\u7406\u3001\u8D44\u6E90\u8C03\u914D\u53CA\u4EBA\u5458\u534F\u8C03\uFF0C\u5177\u5907\u76F8\u5E94\u7BA1\u7406\u6743\u9650\u3002\n\n\u4FB5\u8680\u5EA6\uFF1A0.0%\n\u4FB5\u8680\u8BC4\u7EA7\uFF1A\u65E0\uFF08\u65E0\u4FB5\u8680\uFF09"
  localizedNames:
  - languageCode: zh-CN
    text: AEGIA
  - languageCode: ja
    text: AEGIA
  - languageCode: en
    text: AEGIA
  localizedDescriptions:
  - languageCode: zh-CN
    text: "AEGIA\uFF0C\u6218\u7565\u7EA7\u673A\u5668\u4EBA\uFF0C\u4EAC\u6781\u91CD\u5DE5A.E.G.I.A\u4F01\u5212\u7684\u6700\u7EC8\u4EA7\u54C1\u3002\n\u73B0\u4EFB\u4F59\u7A79\u4EE3\u7406\u8D1F\u8D23\u4EBA\uFF0C\u8D1F\u8D23\u8BBE\u65BD\u8FD0\u884C\u7BA1\u7406\u3001\u8D44\u6E90\u8C03\u914D\u53CA\u4EBA\u5458\u534F\u8C03\uFF0C\u5177\u5907\u76F8\u5E94\u7BA1\u7406\u6743\u9650\u3002\n\n\u4FB5\u8680\u5EA6\uFF1A0.0%\n\u4FB5\u8680\u8BC4\u7EA7\uFF1A\u65E0\uFF08\u65E0\u4FB5\u8680\uFF09"
  - languageCode: ja
    text: "AEGIA\u3002\u4EAC\u6975\u91CD\u5DE5\u306EA.E.G.I.A\u30D7\u30ED\u30B8\u30A7\u30AF\u30C8\u306B\u3088\u3063\u3066\u958B\u767A\u3055\u308C\u305F\u6226\u7565\u7D1A\u30ED\u30DC\u30C3\u30C8\u306E\u6700\u7D42\u5B8C\u6210\u578B\u3002\n\u73FE\u5728\u306F\u30B9\u30C6\u30A3\u30EB\u30F4\u30A9\u30EB\u30C8\u306E\u8CAC\u4EFB\u8005\u4EE3\u884C\u3092\u52D9\u3081\u308B\u3002\u65BD\u8A2D\u306E\u904B\u7528\u7BA1\u7406\u3001\u8CC7\u6E90\u914D\u5206\u3001\u4EBA\u54E1\u8ABF\u6574\u3092\u62C5\u5F53\u3057\u3001\u95A2\u9023\u3059\u308B\u7BA1\u7406\u6A29\u9650\u3092\u6709\u3059\u308B\u3002\n\n\u4FB5\u98DF\u7387\uFF1A0.0%\n\u4FB5\u98DF\u5224\u5B9A\uFF1A\u306A\u3057\uFF08\u4FB5\u98DF\u672A\u691C\u51FA\uFF09"
  - languageCode: en
    text: "AEGIA. A strategic-class robot developed as the completed model of Kyogoku
      Heavy Industries\u2019 A.E.G.I.A project. \nCurrently serves as acting administrator
      of Stillvault. Responsible for facility operations, resource allocation, and
      personnel coordination, with the corresponding administrative authority.\n\nCorruption
      Level: 0.0%\nCorruption Status: None (No corruption detected)"
