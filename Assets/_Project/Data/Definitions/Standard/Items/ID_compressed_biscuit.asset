  nameKey: item_name_compressed_biscuit
  descKey: item_desc_compressed_biscuit
  iconKey: icon_compressed_biscuit
  displayName: "\u538B\u7F29\u997C\u5E72"
  note: 
  description: "\u65E7\u5F0F\u907F\u96BE\u8865\u7ED9\u98DF\u54C1\u3002\u7ECF\u8FC7\u538B\u7F29\u5904\u7406\uFF0C\u4FBF\u4E8E\u643A\u5E26\u4E0E\u957F\u671F\u4FDD\u5B58\u3002
    \n\u5305\u88C5\u4E0A\u4ECD\u80FD\u770B\u89C1\u914D\u7ED9\u7F16\u53F7\uFF0C\u751F\u4EA7\u65E5\u671F\u5DF2\u88AB\u78E8\u635F\u3002\n\u5473\u9053\u8C08\u4E0D\u4E0A\u597D\uFF0C\u4F46\u5728\u957F\u65F6\u95F4\u65AD\u7535\u7684\u533A\u57DF\uFF0C\u5B83\u6BD4\u70ED\u98DF\u66F4\u53EF\u9760\u3002"
  icon: {fileID: 21300000, guid: e28a15dda4c795542bac7533547f1030, type: 3}
  localizedNames:
  - languageCode: zh-CN
    text: "\u538B\u7F29\u997C\u5E72"
  - languageCode: ja-JP
    text: "\u5727\u7E2E\u30D3\u30B9\u30B1\u30C3\u30C8"
  - languageCode: en-US
    text: Compressed Biscuit
  - languageCode: ja
    text: "\u30B5\u30D0\u30A4\u30D0\u30EB\u30D3\u30B9\u30B1\u30C3\u30C8"
  - languageCode: en
    text: Survival Biscuit
  localizedDescriptions:
  - languageCode: zh-CN
    text: "\u65E7\u5F0F\u907F\u96BE\u8865\u7ED9\u98DF\u54C1\u3002\u7ECF\u8FC7\u538B\u7F29\u5904\u7406\uFF0C\u4FBF\u4E8E\u643A\u5E26\u4E0E\u957F\u671F\u4FDD\u5B58\u3002
      \n\u5305\u88C5\u4E0A\u4ECD\u80FD\u770B\u89C1\u914D\u7ED9\u7F16\u53F7\uFF0C\u751F\u4EA7\u65E5\u671F\u5DF2\u88AB\u78E8\u635F\u3002\n\u5473\u9053\u8C08\u4E0D\u4E0A\u597D\uFF0C\u4F46\u5728\u957F\u65F6\u95F4\u65AD\u7535\u7684\u533A\u57DF\uFF0C\u5B83\u6BD4\u70ED\u98DF\u66F4\u53EF\u9760\u3002"
  - languageCode: ja-JP
    text: "\u643A\u884C\u3057\u3084\u3059\u304F\u4FDD\u5B58\u6027\u306B\u512A\u308C\u305F\u57FA\u672C\u98DF\u6599\u3002"
  - languageCode: en-US
    text: A compact ration with good shelf life.
  - languageCode: ja
    text: "\u65E7\u5F0F\u306E\u907F\u96E3\u7528\u4FDD\u5B58\u98DF\u3002\u5727\u7E2E\u52A0\u5DE5\u304C\u65BD\u3055\u308C\u3066\u304A\u308A\u3001\u643A\u5E2F\u6027\u3068\u4FDD\u5B58\u6027\u306B\u512A\u308C\u308B\u3002\n\u5305\u88C5\u306B\u306F\u3001\u304B\u3059\u304B\u306B\u914D\u7D66\u756A\u53F7\u304C\u6B8B\u3063\u3066\u3044\u308B\u3002\u88FD\u9020\u65E5\u306F\u3082\u3046\u8AAD\u307F\u53D6\u308C\u306A\u3044\u3002\n\u5473\u306F\u671F\u5F85\u3067\u304D\u306A\u3044\u304C\u3001\u9577\u304F\u96FB\u529B\u306E\u9014\u7D76\u3048\u305F\u533A\u57DF\u3067\u306F\u3001\u6E29\u304B\u3044\u98DF\u4E8B\u3088\u308A\u3082\u983C\u308A\u306B\u306A\u308B\u3002"
  - languageCode: en
    text: 'An old emergency ration made for evacuation stockpiles. Compressed for
      easy transport and long-term storage.

      A ration number can still be seen
      on the wrapper, though the production date has worn away.

      It does not
      taste like much, but in areas where power has been out for years, it is more
      reliable than a hot meal.'
