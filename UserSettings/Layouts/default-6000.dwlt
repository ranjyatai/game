    \"m_Precision\": 0,\n    \"m_PreviewExpanded\": true,\n    \"m_DismissedVersion\":
    0,\n    \"m_PreviewMode\": 0,\n    \"m_CustomColors\": {\n        \"m_SerializableColors\":
    []\n    },\n    \"m_SourceType\": 1,\n    \"m_FunctionName\": \"ApplyHueShift\",\n   
    \"m_FunctionSource\": \"\",\n    \"m_FunctionSourceUsePragmas\": true,\n    \"m_FunctionBody\":
    \"float angle = radians(hue);\\r\\nfloat3 k = float3(0.57735, 0.57735, 0.57735);\\r\\nfloat
    cosAngle = cos(angle);\\r\\nresult =  aColor * cosAngle + cross(k, aColor) *
    sin(angle) + k * dot(k, aColor) * (1 - cosAngle);\"\n}\n\n{\n    \"m_SGVersion\":
